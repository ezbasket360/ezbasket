generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal
  imageUrl    String?
  category    String?
  active      Boolean  @default(true)
  attributes  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
